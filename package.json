{
	"name": "besidka",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"preinstall": "node scripts/verify-node-types.mjs",
		"build": "ROLLDOWN_OPTIONS_VALIDATION=loose nuxt build",
		"dev": "nuxt dev --dotenv .dev.vars",
		"preview": "pnpm run build && wrangler dev --port 3000",
		"remote:preview": "pnpm run build && wrangler dev --port 3000 --remote",
		"prod:preview": "pnpm run build && wrangler dev --port 3000 --env production --remote",
		"deploy": "pnpm run deploy:preview",
		"deploy:preview": "pnpm run build && wrangler preview --env production --name preview",
		"deploy:prod": "pnpm run build && wrangler deploy --env production",
		"generate": "nuxt generate",
		"dev:prepare": "nuxt prepare",
		"typecheck": "wrangler types > /dev/null && nuxt typecheck",
		"analyze": "ROLLDOWN_OPTIONS_VALIDATION=loose nuxt analyze",
		"cf-typegen": "wrangler types",
		"lint": "eslint",
		"format": "eslint --fix",
		"test": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:unit:changed": "vitest run tests/unit --changed",
		"test:unit:related": "vitest run tests/unit --related",
		"test:unit:watch": "vitest tests/unit",
		"test:integration": "vitest run tests/integration --passWithNoTests",
		"test:integration:watch": "vitest tests/integration",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui --headed --debug",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
		"test:affected": "node scripts/test-affected.mjs",
		"test:affected:unit": "node scripts/test-affected.mjs --type=unit",
		"test:affected:integration": "node scripts/test-affected.mjs --type=integration",
		"test:affected:e2e": "node scripts/test-affected.mjs --type=e2e",
		"test:affected:fast": "node scripts/test-affected.mjs --type=unit && node scripts/test-affected.mjs --type=integration",
		"coverage": "vitest run --coverage --passWithNoTests",
		"coverage:ui": "vitest --coverage --ui",
		"models:fetch": "node scripts/fetch-models-metadata.mjs",
		"db:generate": "drizzle-kit generate",
		"db:reset": "rm -rf .wrangler/state/v3/d1 && drizzle-kit generate && pnpm exec wrangler d1 migrations apply DB",
		"db:migrate": "pnpm exec wrangler d1 migrations apply DB",
		"db:migrate:preview": "pnpm exec wrangler d1 migrations apply DB --remote",
		"db:migrate:prod": "pnpm exec wrangler d1 migrations apply DB --env production --remote",
		"db:studio": "drizzle-kit studio",
		"db:consents:generate": "drizzle-kit generate --config=drizzle-consent.config.ts",
		"db:consents:migrate": "pnpm exec wrangler d1 migrations apply CONSENT_DB",
		"db:consents:migrate:preview": "pnpm exec wrangler d1 migrations apply CONSENT_DB --remote",
		"db:consents:migrate:prod": "pnpm exec wrangler d1 migrations apply CONSENT_DB --env production --remote",
		"prepare": "husky",
		"postinstall": "node scripts/setup-ai-agents.mjs && pnpm --filter @besidka/nuxt-cookie-consent dev:prepare && nuxt prepare",
		"test:cookie-consent": "pnpm --filter @besidka/nuxt-cookie-consent test:run",
		"landing:video": "node scripts/landing-demo-video.mjs",
		"cms:files:upload": "node scripts/cms-bucket-manager.mjs upload",
		"cms:files:download": "node scripts/cms-bucket-manager.mjs download",
		"bench:files-index": "node scripts/bench/files-user-id-index.mjs"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.88",
		"@ai-sdk/deepseek": "^3.0.73",
		"@ai-sdk/gateway": "4.0.126",
		"@ai-sdk/google": "^4.0.105",
		"@ai-sdk/moonshotai": "^3.0.78",
		"@ai-sdk/openai": "^4.0.102",
		"@ai-sdk/openai-compatible": "^3.0.78",
		"@ai-sdk/provider": "^4.0.34",
		"@ai-sdk/typesafe-ai": "3.0.27",
		"@ai-sdk/vue": "^4.0.153",
		"@ai-sdk/xai": "^5.0.30",
		"@besidka/nuxt-cookie-consent": "workspace:*",
		"@better-auth/passkey": "1.7.10",
		"@iconify-json/lucide": "^1.2.145",
		"@joplin/turndown-plugin-gfm": "^1.0.68",
		"@nuxt/content": "^3.16.2",
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/fonts": "^1.0.1",
		"@nuxt/icon": "^2.5.1",
		"@nuxt/image": "^2.1.0",
		"@nuxt/scripts": "^1.3.12",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/device": "^4.0.0",
		"@nuxtjs/i18n": "^10.6.0",
		"@nuxtjs/mcp-toolkit": "0.24.3",
		"@nuxtjs/mdc": "^0.23.2",
		"@nuxtjs/robots": "^7.0.2",
		"@nuxtjs/sitemap": "^9.1.0",
		"@openrouter/ai-sdk-provider": "3.1.0",
		"@panzoom/panzoom": "4.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"@videojs/html": "10.1.0",
		"@vite-pwa/nuxt": "^1.1.1",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"ai": "^7.0.153",
		"better-auth": "^1.7.10",
		"crypto-shield": "^1.6.2",
		"daisyui": "^5.7.50",
		"defu": "^6.1.7",
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5",
		"eslint": "^10.13.0",
		"evlog": "2.33.0",
		"hashids": "^2.3.0",
		"jose": "6.2.12",
		"mammoth": "^1.13.0",
		"minisearch": "^7.2.0",
		"nuxt": "^4.6.2",
		"nuxt-agent-discovery": "^0.8.1",
		"nuxt-email-renderer": "^2.11.1",
		"nuxt-llms": "^0.3.1",
		"nuxt-studio": "1.7.0",
		"nuxt-svgo": "^5.3.0",
		"pele": "1.6.0",
		"read-excel-file": "^9.3.12",
		"remark-breaks": "^4.0.0",
		"sanitize-html": "^2.18.1",
		"shiki": "^4.5.0",
		"shiki-stream": "^0.1.5",
		"tailwindcss": "^4.3.3",
		"turndown": "^7.2.4",
		"ulid": "^3.0.2",
		"unpdf": "^1.9.1",
		"vue": "3.6.0-rc.12",
		"vue-router": "^5.4.0",
		"web-haptics": "0.0.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261018.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/format": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource/nunito": "^5.3.0",
		"@iconify-json/thesvg": "^1.2.11",
		"@nuxt/kit": "^4.6.2",
		"@nuxt/test-utils": "^4.3.4",
		"@playwright/test": "^1.64.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/typography": "^0.5.20",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "24.19.2",
		"@types/sanitize-html": "^2.16.2",
		"@types/turndown": "^5.0.6",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"@vue/test-utils": "^2.5.1",
		"better-sqlite3": "^13.0.3",
		"happy-dom": "^21.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"mediabunny": "^1.61.6",
		"msw": "^2.15.0",
		"playwright-core": "^1.64.1",
		"typescript": "^6.0.3",
		"vite-plugin-eslint2": "^5.3.0",
		"vitest": "^4.1.10",
		"vitest-environment-nuxt": "^2.0.0",
		"vue-tsc": "^3.3.13",
		"whatwg-fetch": "^3.6.20",
		"wrangler": "^4.151.1",
		"yaml": "2.9.0"
	},
	"peerDependencies": {
		"@react-email/render": "^2.0.4"
	},
	"peerDependenciesMeta": {
		"@react-email/render": {
			"optional": true
		}
	},
	"lint-staged": {
		"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}": [
			"eslint --fix"
		]
	}
}
