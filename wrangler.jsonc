				"NUXT_PUBLIC_OPENAI_WEB_SEARCH_COST_PER_THOUSAND_CALLS_USD": "10",
				// Brave Search (Web & LLM Context plan) and Exa are BYOK external
				// search backends, not native provider tools — see
				// docs/gateway-restoration-and-search-providers-plan.md Epic 1.
				// Public, provider-published rates. Brave: $5 / 1,000 requests,
				// documentation-only (as of 2026-09-22), api-dashboard.search.brave.com
				// pricing, NOT invoice-verified. Exa rates are per search level
				// (exa.ai/pricing as of 2026-10-23: lite $4, auto $7, deep $12 per 1,000
