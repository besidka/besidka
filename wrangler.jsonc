{
	"name": "besidka-local",
	"compatibility_date": "2026-01-28",
	"workers_dev": false,
	"preview_urls": false,
	"main": ".output/server/index.mjs",
	"assets": {
		"binding": "ASSETS",
		"directory": ".output/public"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"no_nodejs_compat_v2",
		"nodejs_als"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"NUXT_PUBLIC_BASE_URL": "http://localhost:3000",
		"NUXT_PUBLIC_PRIVACY_EMAIL": "privacy@besidka.com",
		"NUXT_PUBLIC_AUTHOR_GITHUB_PROFILE": "https://github.com/serhii-chernenko",
		"NUXT_EMAIL_SENDER_NOREPLY": "noreply@besidka.com",
		"NUXT_EMAIL_SENDER_PERSONALIZED": "serhii@besidka.com",
		"NUXT_VAPID_SUBJECT": "abuse@besidka.com",
		"NUXT_PUBLIC_VAPID_PUBLIC_KEY": "BDHR5LHg7XCwXVhDv6YAJGDVen7Q1l6xbRBh1C_D2SAIVOnKcOfwzqOn5i7OSviC4Kb2gVd0ideWh-BeJFiaAbQ",
		"NUXT_FILES_RETENTION_CLEANUP_ENABLED": true,
		"NUXT_FILES_RETENTION_CLEANUP_BATCH_SIZE": 100,
		"NUXT_FILES_RETENTION_CLEANUP_MAX_RUNTIME_MS": 20000,
		"NUXT_RESEARCH_SWEEP_ENABLED": true,
		"NUXT_RESEARCH_SWEEP_BATCH_SIZE": 20,
		"NUXT_RESEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
		"NUXT_RESEARCH_MOCK_ENABLED": true,
		"NUXT_MESSAGE_SEARCH_SWEEP_ENABLED": true,
		"NUXT_MESSAGE_SEARCH_SWEEP_BATCH_SIZE": 1000,
		"NUXT_MESSAGE_SEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
		"NUXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// Grounding with Google Search pricing, per ai.google.dev/gemini-api/docs/google-search
		// and .../pricing (as of 2026-09-21; free-quota narrative corrected
		// 2026-09-25, see docs/web-search-cost-accounting.md). Public,
		// provider-published rates — not a secret. Gemini 3.x rate is
		// invoice-verified (paid-one SKU E662-8171-51CB, PR #385); its free
		// allowance (5,000 queries/month) is NOT modelled — cost is always
		// list price x units. Gemini <=2.5 rate is documentation-only.
		"NUXT_PUBLIC_GOOGLE_SEARCH_COST_PER_THOUSAND_QUERIES_USD": "14",
		"NUXT_PUBLIC_GOOGLE_SEARCH_COST_PER_THOUSAND_GROUNDED_PROMPTS_USD": "35",
		// Anthropic web_search and OpenAI web_search are billed per search
		// call, separately from tokens. Public, provider-published rates —
		// not secrets. Anthropic: flat $10 / 1,000 searches, identical
		// across Opus/Sonnet/Haiku (platform.claude.com/docs). OpenAI: this
		// app calls the non-preview `web_search` tool, which bills a flat
		// $10 / 1,000 calls for every OpenAI model, no reasoning/
		// non-reasoning split (developers.openai.com/api/docs/pricing).
		// Both as of 2026-09-22 and documentation-only — NOT
		// invoice-verified the way the Gemini 3.x rate was.
		"NUXT_PUBLIC_ANTHROPIC_WEB_SEARCH_COST_PER_THOUSAND_SEARCHES_USD": "10",
		"NUXT_PUBLIC_OPENAI_WEB_SEARCH_COST_PER_THOUSAND_CALLS_USD": "10",
		// Brave Search (Web & LLM Context plan) and Exa are BYOK external
		// search backends, not native provider tools — see
		// docs/gateway-restoration-and-search-providers-plan.md Epic 1.
		// Public, provider-published rates. Brave: $5 / 1,000 requests,
		// documentation-only (as of 2026-09-22), api-dashboard.search.brave.com
		// pricing, NOT invoice-verified. Exa rates are per search level
		// (exa.ai/pricing as of 2026-10-23: lite $4, auto $7, deep $12 per 1,000
		// requests, up to 10 results). Auto stays on the existing key. Live-verified
		// costDollars.total with the shipped request shape (10 results,
		// `contents.text.maxCharacters: 1500`): 0.007 auto (2026-10-04), 0.004 lite
		// and 0.012 deep (2026-10-23). These fallback rates are used only when Exa's
		// response omits `costDollars`. Brave's LLM Context endpoint is part of the
		// same Search plan ($5/1,000 requests), so the Brave rate is unchanged.
		"NUXT_PUBLIC_BRAVE_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "5",
		"NUXT_PUBLIC_EXA_LITE_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "4",
		"NUXT_PUBLIC_EXA_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "7",
		"NUXT_PUBLIC_EXA_DEEP_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "12",
		// DeepSeek Search API (client-executed `web_search` tool, direct DeepSeek
		// sends only): $0.75 / 1,000 successful requests, where successful means
		// HTTP 200 with a non-empty `results` array — empty-result and failed
		// requests are not billed, and `count` does not change the price.
		// Public, provider-published rate, not a secret. Source:
		// https://api-docs.deepseek.com/quick_start/pricing (accessed 2026-10-17),
		// documentation-only, NOT invoice-verified. See docs/providers/deepseek.md.
		"NUXT_PUBLIC_DEEPSEEK_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "0.75"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "besidka-preview",
			"database_id": "d30ca34f-9b29-4846-a77b-fcbda41cb598",
			"migrations_dir": ".drizzle/migrations",
			"migrations_pattern": ".drizzle/migrations/*/migration.sql"
		},
		{
			"binding": "CONSENT_DB",
			"database_name": "besidka-consent-preview",
			"database_id": "d110f034-1e7a-4512-b4c0-bc1e881b6d02",
			"migrations_dir": ".drizzle/migrations-consent",
			"migrations_pattern": ".drizzle/migrations-consent/*/migration.sql"
		},
		// Nuxt Content v3 uses a dedicated D1 database, separate from the
		// main app DB, to avoid Drizzle migration blast-radius on chat/user
		// data. See README.md § "Content (Nuxt Content + Studio)" for the
		// wrangler d1 create commands to get the real database_id.
		{
			"binding": "CONTENT_DB",
			"database_name": "besidka-content-preview",
			"database_id": "32796d2a-29cc-45f7-99c9-37c6f171f754"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "6ee10a2a05034ba092a9fb815f633e06"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "besidka-preview",
			"binding": "DATA_BUCKET"
		},
		{
			"bucket_name": "besidka-cms-preview",
			"binding": "CMS_BUCKET"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "besidka_cms_events_preview"
		}
	],
	"images": {
    "binding": "IMAGES"
  },
	"ratelimits": [
		{
			"name": "CONSENTS_RATE_LIMITER",
			"namespace_id": "730101",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"noreply@besidka.com",
				"serhii@besidka.com"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *",
			"*/5 * * * *"
		]
	},
	"env": {
		"production": {
			"name": "besidka",
			"workers_dev": false,
			"preview_urls": true,
			"main": ".output/server/index.mjs",
			"assets": {
				"binding": "ASSETS",
				"directory": ".output/public"
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "besidka.com"
				},
