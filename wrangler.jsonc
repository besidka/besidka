					"database_id": "d79f8088-c9ce-4d55-a07c-e3bd564354fb",
					"migrations_dir": ".drizzle/migrations-consent",
					"migrations_pattern": ".drizzle/migrations-consent/*/migration.sql"
				},
				// Nuxt Content v3 dedicated D1 (production). See README.md
				// § "Content (Nuxt Content + Studio)" for setup.
				{
					"binding": "CONTENT_DB",
					"database_name": "besidka-content",
					"database_id": "0d1eab21-938c-4c7b-8aa4-bbfabd9a4a17"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "eb7450a0ca6f4e6ba0b7ab7fd92f3e6a"
				}
			],
			"r2_buckets": [
				{
					"bucket_name": "besidka",
					"binding": "DATA_BUCKET"
				},
				{
					"bucket_name": "besidka-cms",
					"binding": "CMS_BUCKET"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "ANALYTICS",
					"dataset": "besidka_cms_events"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"ratelimits": [
				{
					"name": "CONSENTS_RATE_LIMITER",
					"namespace_id": "730102",
					"simple": {
						"limit": 60,
						"period": 60
					}
				}
			],
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": [
						"noreply@besidka.com",
						"serhii@besidka.com"
					]
				}
			],
			"previews": {
				"vars": {
					"NUXT_PUBLIC_BASE_URL": "https://preview-besidka.chernenko.workers.dev",
					"NUXT_PUBLIC_PRIVACY_EMAIL": "privacy@besidka.com",
					"NUXT_PUBLIC_AUTHOR_GITHUB_PROFILE": "https://github.com/serhii-chernenko",
					"NUXT_EMAIL_SENDER_NOREPLY": "noreply@besidka.com",
					"NUXT_EMAIL_SENDER_PERSONALIZED": "serhii@besidka.com",
					"NUXT_VAPID_SUBJECT": "abuse@besidka.com",
					"NUXT_PUBLIC_VAPID_PUBLIC_KEY": "BDHR5LHg7XCwXVhDv6YAJGDVen7Q1l6xbRBh1C_D2SAIVOnKcOfwzqOn5i7OSviC4Kb2gVd0ideWh-BeJFiaAbQ",
					"NUXT_FILES_RETENTION_CLEANUP_ENABLED": true,
					"NUXT_FILES_RETENTION_CLEANUP_BATCH_SIZE": 100,
