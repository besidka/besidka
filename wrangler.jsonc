{
	"name": "besidka-preview",
	"compatibility_date": "2026-01-28",
	"workers_dev": true,
	"preview_urls": true,
	"main": ".output/server/index.mjs",
	"assets": {
		"binding": "ASSETS",
		"directory": ".output/public"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"no_nodejs_compat_v2",
		"nodejs_als"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"NUXT_PUBLIC_BASE_URL": "https://besidka-preview.chernenko.workers.dev",
		"NUXT_PUBLIC_PRIVACY_EMAIL": "privacy@besidka.com",
		"NUXT_PUBLIC_AUTHOR_GITHUB_PROFILE": "https://github.com/serhii-chernenko",
		"NUXT_EMAIL_SENDER_NOREPLY": "noreply@besidka.com",
		"NUXT_EMAIL_SENDER_PERSONALIZED": "serhii@besidka.com",
		"NUXT_VAPID_SUBJECT": "abuse@besidka.com",
		"NUXT_PUBLIC_VAPID_PUBLIC_KEY": "BDHR5LHg7XCwXVhDv6YAJGDVen7Q1l6xbRBh1C_D2SAIVOnKcOfwzqOn5i7OSviC4Kb2gVd0ideWh-BeJFiaAbQ",
		"NUXT_FILES_RETENTION_CLEANUP_ENABLED": true,
		"NUXT_FILES_RETENTION_CLEANUP_BATCH_SIZE": 100,
		"NUXT_FILES_RETENTION_CLEANUP_MAX_RUNTIME_MS": 20000,
		"NUXT_RESEARCH_SWEEP_ENABLED": true,
		"NUXT_RESEARCH_SWEEP_BATCH_SIZE": 20,
		"NUXT_RESEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
		"NUXT_RESEARCH_MOCK_ENABLED": true,
		"NUXT_MESSAGE_SEARCH_SWEEP_ENABLED": true,
		"NUXT_MESSAGE_SEARCH_SWEEP_BATCH_SIZE": 1000,
		"NUXT_MESSAGE_SEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
		"NUXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// Grounding with Google Search pricing, per ai.google.dev/gemini-api/docs/google-search
		// and .../pricing (as of 2026-09-21). Public, provider-published rates —
		// not a secret. Gemini 3.x rate invoice-verified (see PR #385); the
		// Gemini <=2.5 rate is documentation-only.
		"NUXT_GOOGLE_SEARCH_COST_PER_THOUSAND_QUERIES_USD": "14",
		"NUXT_GOOGLE_SEARCH_COST_PER_THOUSAND_GROUNDED_PROMPTS_USD": "35",
		// Anthropic web_search and OpenAI web_search are billed per search
		// call, separately from tokens. Public, provider-published rates —
		// not secrets. Anthropic: flat $10 / 1,000 searches, identical
		// across Opus/Sonnet/Haiku (platform.claude.com/docs). OpenAI: this
		// app calls the non-preview `web_search` tool, which bills a flat
		// $10 / 1,000 calls for every OpenAI model, no reasoning/
		// non-reasoning split (developers.openai.com/api/docs/pricing).
		// Both as of 2026-09-22 and documentation-only — NOT
		// invoice-verified the way the Gemini 3.x rate was.
		"NUXT_ANTHROPIC_WEB_SEARCH_COST_PER_THOUSAND_SEARCHES_USD": "10",
		"NUXT_OPENAI_WEB_SEARCH_COST_PER_THOUSAND_CALLS_USD": "10",
		// Brave Search (Web & LLM Context plan) and Exa are BYOK external
		// search backends, not native provider tools — see
		// docs/gateway-restoration-and-search-providers-plan.md Epic 1.
		// Public, provider-published rates. Brave: $5 / 1,000 requests,
		// documentation-only (as of 2026-09-22), api-dashboard.search.brave.com
		// pricing, NOT invoice-verified. Exa: $7 / 1,000 base search requests
		// (exa.ai/pricing) — this fallback rate is used only when Exa's own
		// response omits `costDollars`, which the live path always prefers.
		// Exa's pricing page separately lists a $1/1,000-per-extracted-page
		// highlights charge that would put this app's fixed 10-result,
		// highlights-on request shape at $17/1,000 — but two real smoke-test
		// calls against that exact shape on 2026-09-22 both reported
		// `costDollars.total: 0.007` ($7/1,000, base fee only, no separate
		// highlights line). Set to the empirically-observed $7, not the
		// theoretical $17 the pricing page alone would suggest — re-verify
		// with more samples before raising it back.
		"NUXT_BRAVE_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "5",
		"NUXT_EXA_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "7"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "besidka-preview",
			"database_id": "d30ca34f-9b29-4846-a77b-fcbda41cb598",
			"migrations_dir": ".drizzle/migrations",
			"migrations_pattern": ".drizzle/migrations/*/migration.sql"
		},
		{
			"binding": "CONSENT_DB",
			"database_name": "besidka-consent-preview",
			"database_id": "d110f034-1e7a-4512-b4c0-bc1e881b6d02",
			"migrations_dir": ".drizzle/migrations-consent",
			"migrations_pattern": ".drizzle/migrations-consent/*/migration.sql"
		},
		// Nuxt Content v3 uses a dedicated D1 database, separate from the
		// main app DB, to avoid Drizzle migration blast-radius on chat/user
		// data. See README.md § "Content (Nuxt Content + Studio)" for the
		// wrangler d1 create commands to get the real database_id.
		{
			"binding": "CONTENT_DB",
			"database_name": "besidka-content-preview",
			"database_id": "32796d2a-29cc-45f7-99c9-37c6f171f754"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "6ee10a2a05034ba092a9fb815f633e06"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "besidka-preview",
			"binding": "DATA_BUCKET"
		},
		{
			"bucket_name": "besidka-cms-preview",
			"binding": "CMS_BUCKET"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "besidka_cms_events_preview"
		}
	],
	"images": {
    "binding": "IMAGES"
  },
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"noreply@besidka.com",
				"serhii@besidka.com"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *",
			"*/5 * * * *"
		]
	},
	"env": {
		"production": {
			"name": "besidka",
			"workers_dev": false,
			"preview_urls": false,
			"main": ".output/server/index.mjs",
			"assets": {
				"binding": "ASSETS",
				"directory": ".output/public"
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "besidka.com"
				},
				{
					"pattern": "www.besidka.com/*",
					"zone_name": "besidka.com"
				}
			],
			"triggers": {
				"crons": [
					"0 * * * *",
					"*/5 * * * *"
				]
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.1
				}
			},
			"vars": {
				"NUXT_PUBLIC_BASE_URL": "https://besidka.com",
				"NUXT_PUBLIC_PRIVACY_EMAIL": "privacy@besidka.com",
				"NUXT_PUBLIC_AUTHOR_GITHUB_PROFILE": "https://github.com/serhii-chernenko",
				"NUXT_EMAIL_SENDER_NOREPLY": "noreply@besidka.com",
				"NUXT_EMAIL_SENDER_PERSONALIZED": "serhii@besidka.com",
				"NUXT_VAPID_SUBJECT": "abuse@besidka.com",
				"NUXT_PUBLIC_VAPID_PUBLIC_KEY": "BMHfsKCit5SCDRu10-nPopt23_fvj6QJ8KLF5dEmv1sNG48O_7zcgwkxjQwLvKOO863YdKtsn4dE5Gm0GdboKwk",
				"NUXT_FILES_RETENTION_CLEANUP_ENABLED": true,
				"NUXT_FILES_RETENTION_CLEANUP_BATCH_SIZE": 100,
				"NUXT_FILES_RETENTION_CLEANUP_MAX_RUNTIME_MS": 20000,
				"NUXT_RESEARCH_SWEEP_ENABLED": true,
				"NUXT_RESEARCH_SWEEP_BATCH_SIZE": 20,
				"NUXT_RESEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
				"NUXT_RESEARCH_MOCK_ENABLED": true,
				"NUXT_MESSAGE_SEARCH_SWEEP_ENABLED": true,
				"NUXT_MESSAGE_SEARCH_SWEEP_BATCH_SIZE": 1000,
				"NUXT_MESSAGE_SEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
				"NUXT_TURNSTILE_ENFORCED": true,
				"NUXT_AXIOM_DATASET": "besidka-prod",
				"NUXT_AXIOM_AUDIT_DATASET": "besidka-audit-prod",
				"NUXT_AXIOM_CONSENT_DATASET": "besidka-consent-prod",
				"NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEFMAZiwbUuiy0qi",
				// Grounding with Google Search pricing, per ai.google.dev/gemini-api/docs/google-search
				// and .../pricing (as of 2026-09-21). Public, provider-published rates —
				// not a secret. Gemini 3.x rate invoice-verified (see PR #385); the
				// Gemini <=2.5 rate is documentation-only.
				"NUXT_GOOGLE_SEARCH_COST_PER_THOUSAND_QUERIES_USD": "14",
				"NUXT_GOOGLE_SEARCH_COST_PER_THOUSAND_GROUNDED_PROMPTS_USD": "35",
				// Anthropic web_search and OpenAI web_search are billed per search
				// call, separately from tokens. Public, provider-published rates —
				// not secrets. Anthropic: flat $10 / 1,000 searches, identical
				// across Opus/Sonnet/Haiku (platform.claude.com/docs). OpenAI: this
				// app calls the non-preview `web_search` tool, which bills a flat
				// $10 / 1,000 calls for every OpenAI model, no reasoning/
				// non-reasoning split (developers.openai.com/api/docs/pricing).
				// Both as of 2026-09-22 and documentation-only — NOT
				// invoice-verified the way the Gemini 3.x rate was.
				"NUXT_ANTHROPIC_WEB_SEARCH_COST_PER_THOUSAND_SEARCHES_USD": "10",
				"NUXT_OPENAI_WEB_SEARCH_COST_PER_THOUSAND_CALLS_USD": "10",
				// Brave Search (Web & LLM Context plan) and Exa are BYOK external
				// search backends, not native provider tools — see
				// docs/gateway-restoration-and-search-providers-plan.md Epic 1.
				// Public, provider-published rates. Brave: $5 / 1,000 requests,
				// documentation-only (as of 2026-09-22), api-dashboard.search.brave.com
				// pricing, NOT invoice-verified. Exa: $7 / 1,000 base search requests
				// (exa.ai/pricing) — this fallback rate is used only when Exa's own
				// response omits `costDollars`, which the live path always prefers.
				// Exa's pricing page separately lists a $1/1,000-per-extracted-page
				// highlights charge that would put this app's fixed 10-result,
				// highlights-on request shape at $17/1,000 — but two real smoke-test
				// calls against that exact shape on 2026-09-22 both reported
				// `costDollars.total: 0.007` ($7/1,000, base fee only, no separate
				// highlights line). Set to the empirically-observed $7, not the
				// theoretical $17 the pricing page alone would suggest — re-verify
				// with more samples before raising it back.
				"NUXT_BRAVE_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "5",
				"NUXT_EXA_SEARCH_COST_PER_THOUSAND_REQUESTS_USD": "7"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "besidka",
					"database_id": "4d03fd8e-027e-4485-bd11-f387b1677e88",
					"migrations_dir": ".drizzle/migrations",
					"migrations_pattern": ".drizzle/migrations/*/migration.sql"
				},
				{
					"binding": "CONSENT_DB",
					"database_name": "besidka-consent",
					"database_id": "d79f8088-c9ce-4d55-a07c-e3bd564354fb",
					"migrations_dir": ".drizzle/migrations-consent",
					"migrations_pattern": ".drizzle/migrations-consent/*/migration.sql"
				},
				// Nuxt Content v3 dedicated D1 (production). See README.md
				// § "Content (Nuxt Content + Studio)" for setup.
				{
					"binding": "CONTENT_DB",
					"database_name": "besidka-content",
					"database_id": "0d1eab21-938c-4c7b-8aa4-bbfabd9a4a17"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "eb7450a0ca6f4e6ba0b7ab7fd92f3e6a"
				}
			],
			"r2_buckets": [
				{
					"bucket_name": "besidka",
					"binding": "DATA_BUCKET"
				},
				{
					"bucket_name": "besidka-cms",
					"binding": "CMS_BUCKET"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "ANALYTICS",
					"dataset": "besidka_cms_events"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": [
						"noreply@besidka.com",
						"serhii@besidka.com"
					]
				}
			]
		}
	}
}
