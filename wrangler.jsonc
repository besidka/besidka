				"NUXT_RESEARCH_MOCK_ENABLED": true,
				"NUXT_MESSAGE_SEARCH_SWEEP_ENABLED": true,
				"NUXT_MESSAGE_SEARCH_SWEEP_BATCH_SIZE": 1000,
				"NUXT_MESSAGE_SEARCH_SWEEP_MAX_RUNTIME_MS": 20000,
				"NUXT_TURNSTILE_ENFORCED": true,
				"NUXT_AXIOM_DATASET": "besidka-prod",
				"NUXT_AXIOM_AUDIT_DATASET": "besidka-audit-prod",
				"NUXT_AXIOM_CONSENT_DATASET": "besidka-consent-prod",
				"NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEFMAZiwbUuiy0qi",
				// Grounding with Google Search pricing, per ai.google.dev/gemini-api/docs/google-search
				// and .../pricing (as of 2026-09-21; free-quota narrative
