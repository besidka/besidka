					"pattern": "www.besidka.com/*",
					"zone_name": "besidka.com"
				}
			],
			"triggers": {
				"crons": [
					"0 * * * *",
					"*/5 * * * *"
				]
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.1
				}
			},
			"vars": {
				"NUXT_PUBLIC_BASE_URL": "https://besidka.com",
				"NUXT_PUBLIC_PRIVACY_EMAIL": "privacy@besidka.com",
				"NUXT_PUBLIC_AUTHOR_GITHUB_PROFILE": "https://github.com/serhii-chernenko",
				"NUXT_EMAIL_SENDER_NOREPLY": "noreply@besidka.com",
				"NUXT_EMAIL_SENDER_PERSONALIZED": "serhii@besidka.com",
				"NUXT_VAPID_SUBJECT": "abuse@besidka.com",
				"NUXT_PUBLIC_VAPID_PUBLIC_KEY": "BMHfsKCit5SCDRu10-nPopt23_fvj6QJ8KLF5dEmv1sNG48O_7zcgwkxjQwLvKOO863YdKtsn4dE5Gm0GdboKwk",
				"NUXT_FILES_RETENTION_CLEANUP_ENABLED": true,
				"NUXT_FILES_RETENTION_CLEANUP_BATCH_SIZE": 100,
				"NUXT_FILES_RETENTION_CLEANUP_MAX_RUNTIME_MS": 20000,
				"NUXT_RESEARCH_SWEEP_ENABLED": true,
