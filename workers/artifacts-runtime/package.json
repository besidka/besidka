{
  "name": "artifacts-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "theme": "node scripts/theme.mjs",
    "dev": "node scripts/build.mjs --dev && wrangler dev --port 8788",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@besidka/artifacts-protocol": "workspace:*",
    "@fontsource/nunito": "5.3.0",
    "daisyui": "5.8.1",
    "dompurify": "3.4.18",
    "es-module-lexer": "3.0.5",
    "esbuild": "0.28.2",
    "lucide-react": "1.77.0",
    "marked": "18.2.1",
    "pele": "1.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.11.0",
    "shiki": "4.6.0",
    "sucrase": "3.35.1",
    "tailwindcss": "4.3.5",
    "wrangler": "4.166.0"
  }
}
