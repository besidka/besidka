{
  "name": "artifacts-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/build.mjs --dev && wrangler dev --port 8788",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@besidka/artifacts-protocol": "workspace:*",
    "es-module-lexer": "3.0.4",
    "esbuild": "0.28.2",
    "lucide-react": "1.70.0",
    "marked": "18.1.3",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "sucrase": "3.35.1",
    "wrangler": "4.151.1"
  }
}
